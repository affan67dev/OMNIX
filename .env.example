# Browser/Vite build-time values (public; never put service-role credentials here)
VITE_API_BASE_URL=https://your-backend.example
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace_me
# VITE_SUPABASE_PUBLISHABLE_KEY=replace_me

# Runtime
ENVIRONMENT=production
FRONTEND_URL=https://your-frontend.example
ENABLE_DOCS=false

# Supabase server credentials — NEVER expose the service role key to the frontend
SUPABASE_URL=https://wvekrddnalmgfnvhycwl.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Application JWT/session security: use long random secrets (32+ chars)
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60
OTP_PEPPER=replace_with_a_second_long_random_secret
OTP_TTL_MINUTES=5
EXPOSE_DEV_OTP=false

# Fast2SMS OTP delivery (backend-only; never use VITE_ prefix)
FAST2SMS_API_KEY=replace_me
FAST2SMS_BASE_URL=https://www.fast2sms.com/dev
FAST2SMS_OTP_ID=replace_with_fast2sms_otp_template_id
FAST2SMS_OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Google Play billing
GOOGLE_PLAY_PACKAGE_NAME=com.omnix.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_WEBHOOK_SECRET=replace_me

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=omnix-bytechat
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=
