# OMNIX-only production configuration. Never copy credentials from another project.
# Public frontend values (publishable/anon key only; never service-role keys)
VITE_API_BASE_URL=https://omnix-social-api.onrender.com
VITE_SUPABASE_URL=https://your-dedicated-omnix-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace_with_omnix_publishable_key
# Optional legacy alias:
# VITE_SUPABASE_ANON_KEY=replace_with_omnix_anon_key

# Dedicated OMNIX API runtime
ENVIRONMENT=production
FRONTEND_URL=https://omnix-social-web.onrender.com
ENABLE_DOCS=false
GLOBAL_RATE_LIMIT=120/minute
RATE_LIMIT_STORAGE_URI=memory://
SUPABASE_URL=https://your-dedicated-omnix-project.supabase.co
SUPABASE_ANON_KEY=replace_with_omnix_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_omnix_service_role_key

# Independent session/OTP signing secrets (generate unique random values)
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60
OTP_PEPPER=replace_with_a_second_long_random_secret
OTP_TTL_MINUTES=5
EXPOSE_DEV_OTP=false

# Optional integrations — configure only with OMNIX-owned credentials
FAST2SMS_API_KEY=
FAST2SMS_BASE_URL=https://www.fast2sms.com/dev
FAST2SMS_OTP_ID=
FAST2SMS_OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
GOOGLE_PLAY_PACKAGE_NAME=com.omnix.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=
