# Runtime
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
ENABLE_DOCS=false

# Public web client values. Safe for VITE_* because the Supabase anon key is subject to RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://127.0.0.1:8000

# Server-only Supabase values. NEVER expose the service-role key as VITE_*.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application JWT/session security
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60
OTP_PEPPER=replace_with_a_second_long_random_secret
OTP_TTL_MINUTES=5
EXPOSE_DEV_OTP=false

# Admin API protection
ADMIN_API_KEY=replace_with_a_long_random_admin_key

# OTP delivery adapter
SMS_WEBHOOK_URL=https://your-sms-adapter.example/send

# Google Play billing
GOOGLE_PLAY_PACKAGE_NAME=com.omnix.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_WEBHOOK_SECRET=replace_me

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Vercel GitHub Actions deployment
# Store these in GitHub Actions secrets, not in this file.
VERCEL_TOKEN=replace_me
VERCEL_ORG_ID=replace_me
VERCEL_PROJECT_ID=replace_me
