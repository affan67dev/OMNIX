# Runtime
ENVIRONMENT=production
FRONTEND_URL=https://your-frontend.example
ENABLE_DOCS=false

# Supabase server credentials — NEVER expose the service role key to the frontend
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me

# Application JWT/session security: use long random secrets (32+ chars)
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=60
OTP_PEPPER=replace_with_a_second_long_random_secret
OTP_TTL_MINUTES=5
EXPOSE_DEV_OTP=false

# OTP delivery adapter
SMS_WEBHOOK_URL=https://your-internal-sms-adapter.example/send

# Google Play billing
GOOGLE_PLAY_PACKAGE_NAME=com.omnix.app
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_WEBHOOK_SECRET=replace_me

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=omnix-bytechat
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT_JSON=
